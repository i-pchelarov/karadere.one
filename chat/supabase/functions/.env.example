# Локални стойности за `supabase functions serve chat --env-file ./supabase/functions/.env`
# Копирай в .env (игнориран от git) и попълни. НЕ комитвай реални стойности.
#
# За деплой същите имена се качват с:
#   supabase secrets set --env-file ./supabase/functions/.env --project-ref <ref>
# или поединично:
#   supabase secrets set OPENROUTER_API_KEY=... CHAT_LLM_MODEL=... --project-ref <ref>

# --- задължителни -----------------------------------------------------------
# Ключ за OpenRouter (embeddings + chat completions).
OPENROUTER_API_KEY=

# --- конфигурация на бекенда ------------------------------------------------
# LLM за отговорите. Сменя се без промяна на код.
CHAT_LLM_MODEL=google/gemma-4-26b-a4b-it:free
CHAT_LLM_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,xingchen-agi/xing4.0-29b-a4b:free
# Резервни модели при 429/срив — разделени със запетая, по приоритет.
# ВАЖНО: само `:free` модели, иначе при fallback се таксува.
# ВАЖНО: основен + резервни ≤ 3 (OpenRouter връща 400 при повече).
CHAT_LLM_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Модел и размерност за embeddings — трябва да съвпадат с ingest pipeline-а.
CHAT_EMBED_MODEL=openai/text-embedding-3-small
CHAT_EMBED_DIMENSIONS=768

# --- retrieval tuning (същите имена като в rag/rag_query.mjs) ---------------
RAG_VECTOR_THRESHOLD=0.2
RAG_HYBRID_WEAK_TOP=0.38
RAG_HYBRID_CONFIDENT_TOP=0.62
RAG_HYBRID_MIN_HITS=2
RAG_HYBRID_FETCH_FACTOR=4
RAG_HYBRID_FETCH_LIMIT=200
RAG_HYBRID_MAX_TERMS=8
RAG_HYBRID_MIN_TERM_LEN=3

# --- лимити на заявката (Ф.2/Ф.4) -------------------------------------------
CHAT_MAX_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_TOKENS=2000
# Reasoning токените се броят към CHAT_MAX_TOKENS. При кратък правен отговор те
# само изяждат бюджета и отговорът излиза отрязан (finish_reason: "length").
# 0 = изключено (по подразбиране), 1 = включено.
CHAT_REASONING=0
CHAT_TOP_K=6

# --- CORS (Ф.4) -------------------------------------------------------------
CHAT_ALLOWED_ORIGIN=https://karadere.one

# --- Turnstile (Ф.4, отложено) ----------------------------------------------
# TURNSTILE_SECRET_KEY=
