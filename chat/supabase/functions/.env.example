# Локални стойности за `supabase functions serve chat --env-file ./supabase/functions/.env`
# Копирай в .env (игнориран от git) и попълни. НЕ комитвай реални стойности.
#
# За деплой същите имена се качват с:
#   supabase secrets set --env-file ./supabase/functions/.env --project-ref <ref>
# или поединично:
#   supabase secrets set OPENROUTER_API_KEY=... CHAT_LLM_MODEL=... --project-ref <ref>

# --- задължителни -----------------------------------------------------------
# Ключ за OpenRouter (embeddings + chat completions).
OPENROUTER_API_KEY=

# --- конфигурация на бекенда ------------------------------------------------
# LLM за отговорите. Сменя се без промяна на код.
CHAT_LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Резервни модели при 429/срив — разделени със запетая, по приоритет.
# ВАЖНО: само `:free` модели, иначе при fallback се таксува.
# ВАЖНО: основен + резервни ≤ 3 (OpenRouter връща 400 при повече).
CHAT_LLM_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Модел и размерност за embeddings — трябва да съвпадат с ingest pipeline-а.
CHAT_EMBED_MODEL=openai/text-embedding-3-small
CHAT_EMBED_DIMENSIONS=768

# --- retrieval tuning (същите имена като в rag/rag_query.mjs) ---------------
RAG_VECTOR_THRESHOLD=0.2
RAG_HYBRID_WEAK_TOP=0.38
RAG_HYBRID_CONFIDENT_TOP=0.62
RAG_HYBRID_MIN_HITS=2
RAG_HYBRID_FETCH_FACTOR=4
RAG_HYBRID_FETCH_LIMIT=200
RAG_HYBRID_MAX_TERMS=8
RAG_HYBRID_MIN_TERM_LEN=3

# --- лимити на заявката (Ф.2/Ф.4) -------------------------------------------
CHAT_MAX_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_TOKENS=2000
# Reasoning токените се броят към CHAT_MAX_TOKENS. При кратък правен отговор те
# само изяждат бюджета и отговорът излиза отрязан (finish_reason: "length").
# 0 = изключено (по подразбиране), 1 = включено.
CHAT_REASONING=0
CHAT_TOP_K=6

# --- повторен опит при 429/5xx от OpenRouter (Опция C) ----------------------
# CHAT_RETRY_ATTEMPTS включва първия опит (3 = до 2 повторения).
# Паузата е експоненциална (base * 2^(n-1)) с до 20% жули, ограничена от max.
# При `Retry-After` от доставчика се използва той, ако е по-кратък от max.
CHAT_RETRY_ATTEMPTS=3
CHAT_RETRY_BASE_MS=500
CHAT_RETRY_MAX_MS=4000

# --- CORS (Ф.4) -------------------------------------------------------------
# Списък, разделен със запетая. Ехо на Origin-а само ако е в списъка.
CHAT_ALLOWED_ORIGINS=https://karadere.one,https://www.karadere.one

# --- rate limit по IP (Ф.4) -------------------------------------------------
# Фиксиран прозорец: до CHAT_RATE_LIMIT_PER_WINDOW заявки на IP за
# CHAT_RATE_LIMIT_WINDOW_SECONDS секунди. 0 изключва лимита.
# Изисква миграцията chat_rate_limit + SUPABASE_SERVICE_ROLE_KEY (инжектира се
# автоматично от Supabase; не се задава ръчно).
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_PER_WINDOW=20

# --- Turnstile (Ф.4) --------------------------------------------------------
# Секретен ключ за сървърната проверка. Празен = проверката се прескача
# (локално/тестове). Публичният site key отива в _config.yml (turnstile_site_key).
TURNSTILE_SECRET_KEY=
# Очаквано действие — трябва да съвпада с data-action на widget-а.
TURNSTILE_ACTION=chat
# Разрешени hostname-и от siteverify (разделени със запетая). Продукция:
# karadere.one,www.karadere.one. Локално: localhost,127.0.0.1.
# Празно = проверката на hostname се прескача.
TURNSTILE_HOSTNAMES=karadere.one,www.karadere.one

# --- общ таван на контекста (Ф.4) -------------------------------------------
# Общ брой знаци в цялата история (всички съобщения). Пази от дълги истории,
# които минават поединичните лимити, но надуват контекста и цената.
CHAT_MAX_TOTAL_CHARS=24000
